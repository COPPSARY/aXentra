# Server
NODE_ENV=development
PORT=5000

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key


#cloudflare
TRUST_PROXY=
TRUST_CLOUDFLARE_ONLY=
REQUEST_DEBUG_ENABLED=


# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1d

# Refresh Tokens
REFRESH_TOKEN_TTL_DAYS=30
AUTH_REFRESH_COOKIE_NAME=refreshToken
AUTH_REFRESH_COOKIE_PATH=/api/auth
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=lax

# Avatar upload
SUPABASE_AVATAR_BUCKET=avatars
SUPABASE_AVATAR_BUCKET_PUBLIC=true
AVATAR_MAX_FILE_SIZE_BYTES=2097152 // 2MB
AVATAR_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# File upload
SUPABASE_FILE_BUCKET=files
SUPABASE_FILE_BUCKET_PUBLIC=false
FILE_MAX_FILE_SIZE_BYTES=10485760 // 10MB
FILE_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png

# Private asset album uploads
SUPABASE_ASSET_ALBUM_BUCKET=asset-albums
SUPABASE_ASSET_ALBUM_BUCKET_PUBLIC=false
ASSET_ALBUM_MAX_FILE_SIZE_BYTES=10485760
ASSET_ALBUM_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp

# Public asset display images
SUPABASE_ASSET_DISPLAY_IMAGE_BUCKET=asset-display-images

# Private software license album uploads
SUPABASE_SOFTWARE_LICENSE_ALBUM_BUCKET=software-license-albums
SUPABASE_SOFTWARE_LICENSE_ALBUM_BUCKET_PUBLIC=false
SOFTWARE_LICENSE_ALBUM_MAX_FILE_SIZE_BYTES=10485760
SOFTWARE_LICENSE_ALBUM_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@yourdomain.com

#cron job
ENABLE_OVERDUE_CRON = true
OVERDUE_CRON_SCHEDULE = intervaul every midnight
OVERDUE_CRON_TIMEZONE = UTC

# Frontend URL 
FRONTEND_URL=http://localhost:5173
