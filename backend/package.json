{
  "name": "backend",
  "version": "1.0.0",
  "description": "IT Asset Inventory Backend - Node + Express + Supabase",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "t": "npm run test",
    "tu": "npm run test:unit",
    "ti": "npm run test:integration",
    "tauth": "npm run test:auth",
    "twatch": "vitest",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:routes": "vitest run test/integration/routes",
    "test:auth": "vitest run test/integration/routes/auth.routes.test.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/docs/swagger', 'dist/docs/swagger', { recursive: true })\""
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@supabase/supabase-js": "^2.104.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "node-cron": "^4.5.0",
    "nodemailer": "^6.9.15",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.1.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.0.16"
  }
}
